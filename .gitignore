# ------------------------------------------------------------
# Forge .gitignore
# Only files needed to build and run the app belong in the repo.
# ------------------------------------------------------------

# Design source files and working material (local only)
_assets/
_to_delete/

# AI assistant / build prompt files (local only)
PROMPT.md
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
_notes/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv-cache/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
report.xml
htmlcov/

# Build and packaging output
build/
dist/
*.AppImage
*.dmg
AppDir/

# Logs and local runtime data
*.log
.env
.env.*
# FORGE_HOME folders used for local testing
forge-home/

# Hand-over archives between sessions (always local)
*.tgz
*.tar.gz

# OS and editor files
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
